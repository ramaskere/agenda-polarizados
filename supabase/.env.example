# Secrets de las Edge Functions. Se cargan con:
#   supabase secrets set --env-file supabase/.env.local
# (copiar este archivo como supabase/.env.local con los valores reales,
# ese .env.local está en .gitignore, nunca se commitea).
#
# SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY los inyecta Supabase solo, no se
# configuran acá.

SITE_URL=https://ramaskere.github.io/agenda-polarizados

MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

META_PIXEL_ID=
META_CAPI_TOKEN=

# Secret compartido para que el cron (GitHub Actions) pueda llamar a
# liberar-vencidos. Generar algo random, ej: openssl rand -hex 20
CRON_SECRET=
